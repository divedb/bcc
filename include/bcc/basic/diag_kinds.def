DIAG(err_flexible_array_empty_struct, kError, "",
     "flexible array member '%0' not allowed in otherwise empty struct")
DIAG(err_field_function_type, kError, "", "field '%0' declared as a function")
DIAG(err_bitfield_not_integer, kError, "",
     "bit-field '%0' has non-integral type '%1'")
DIAG(err_bitfield_width_not_ice, kError, "",
     "bit-field '%0' width not an integer constant expression")
DIAG(err_bitfield_negative_width, kError, "",
     "bit-field '%0' has negative width (%1)")
DIAG(err_bitfield_width_exceeds_type_width, kError, "",
     "width of bit-field '%0' (%1 bits) exceeds the width of its type "
     "(%2 bits)")
DIAG(err_bitfield_zero_width_named, kError, "",
     "named bit-field '%0' has zero width")
DIAG(err_duplicate_member, kError, "", "duplicate member '%0'")
DIAG(note_previous_member, kNote, "", "previous declaration is here")
DIAG(err_nested_redefinition, kError, "", "nested redefinition of '%0'")
DIAG(err_use_with_wrong_tag, kError, "",
     "use of '%0' with tag type that does not match previous declaration")
DIAG(err_enum_invalid_underlying, kError, "",
     "enumerator value is not an integer constant expression")
DIAG(err_enumerator_too_large, kError, "",
     "enumerator value is not representable in the underlying type 'int'")
DIAG(err_variable_incomplete_type, kError, "",
     "variable has incomplete type '%0'")
DIAG(err_typecheck_decl_incomplete_type, kError, "",
     "tentative definition has type '%0' that is never completed")
DIAG(err_func_returning_array_function, kError, "",
     "function cannot return %0 type '%1'")
DIAG(err_array_of_functions, kError, "", "'%0' declared as array of functions")
DIAG(err_illegal_decl_array_incomplete_type, kError, "",
     "array has incomplete element type '%0'")
DIAG(err_typecheck_negative_array_size, kError, "",
     "'%0' declared as an array with a negative size")
DIAG(warn_typecheck_zero_array_size, kWarning, "zero-length-array",
     "zero size arrays are an extension")
DIAG(err_array_size_non_int, kError, "",
     "size of array has non-integer type '%0'")
DIAG(err_vla_unsupported, kError, "",
     "variable length arrays are not supported")
DIAG(err_typedef_cannot_have_initializer, kError, "",
     "illegal initializer (only variables can be initialized)")
DIAG(err_func_cannot_have_initializer, kError, "",
     "illegal initializer (only variables can be initialized)")
DIAG(err_extern_has_initializer, kWarning, "extern-initializer",
     "'extern' variable has an initializer")
DIAG(err_block_extern_cant_init, kError, "",
     "'extern' variable cannot have an initializer")
DIAG(err_param_not_declared, kError, "", "parameter named '%0' is missing")
DIAG(err_parameter_name_omitted, kError, "", "parameter name omitted")
DIAG(err_typecheck_sclass_fscope, kError, "",
     "illegal storage class on file-scoped variable")
DIAG(err_typecheck_sclass_func, kError, "", "illegal storage class on function")
DIAG(err_static_block_func, kError, "",
     "function declared in block scope cannot have 'static' storage class")
DIAG(err_void_only_param, kError, "",
     "'void' must be the first and only parameter if specified")
DIAG(err_param_incomplete_type, kError, "", "variable has incomplete type '%0'")
DIAG(err_func_def_incomplete_result, kError, "",
     "incomplete result type '%0' in function definition")
DIAG(err_static_assert_failed, kError, "", "static assertion failed%0")
DIAG(err_static_assert_expression_is_not_constant, kError, "",
     "static assertion expression is not an integral constant expression")
DIAG(err_main_returns_nonint, kWarning, "main-return-type",
     "return type of 'main' is not 'int'")
DIAG(err_label_redefinition, kError, "", "redefinition of label '%0'")
DIAG(err_undeclared_label_use, kError, "", "use of undeclared label '%0'")
DIAG(warn_unused_variable, kWarning, "unused-variable", "unused variable '%0'")

//===----------------------------------------------------------------------===//
// Sema: type diagnostics
//===----------------------------------------------------------------------===//
DIAG(err_invalid_sign_spec, kError, "", "'%0' cannot be signed or unsigned")
DIAG(err_invalid_width_spec, kError, "",
     "'%0' cannot be short, long, or long long")
