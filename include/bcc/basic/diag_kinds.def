// DIAG(id, Severity, "group", "message template")
//
// Severity is one of: kNote, kWarning, kError, kFatal
// Group is the diagnostic group name (e.g. "unused-variable"), or "" for none.
// Message arguments are referenced as %0, %1, … %N.
// Use %% to emit a literal percent sign.

// Lexer diagnostics
DIAG(err_invalid_utf8, kError, "", "invalid UTF-8 sequence")
DIAG(err_unterminated_block_comment, kError, "", "unterminated /* comment */")
DIAG(err_unterminated_string_literal, kError, "", "unterminated string literal")
DIAG(err_unterminated_char_constant, kError, "",
     "unterminated character constant")
DIAG(err_malformed_ucn, kError, "",
     "incomplete universal character name; expected "
     "\\u<4 hex digits> or \\U<8 hex digits>")
DIAG(err_forbidden_ucn_codepoint, kError, "",
     "universal character name refers to a disallowed control character")
DIAG(err_invalid_ucn_in_identifier, kError, "",
     "universal character name cannot begin an identifier")

// File/IO diagnostics
DIAG(err_cannot_open_file, kError, "", "cannot open '%0': %1")
DIAG(err_no_input_file, kError, "", "no input file")

// Type-checking diagnostics
DIAG(warn_int_conversion, kWarning, "int-conversion",
     "incompatible integer to pointer conversion initializing '%0' with an "
     "expression of type '%1'")
DIAG(warn_incompatible_ptr_types_discards_qualifiers, kWarning,
     "incompatible-pointer-types-discards-qualifiers",
     "initializing '%0' with an expression of type '%1' discards qualifiers")

// Parser diagnostics
DIAG(err_expected_rparen, kError, "", "expected ')'")
DIAG(note_to_match_this_lparen, kNote, "", "to match this '('")

// Preprocessor conditional / expression diagnostics
DIAG(err_pp_expected_value, kError, "",
     "expected value in preprocessor expression")
DIAG(err_pp_expected_rparen, kError, "",
     "expected ')' in preprocessor expression")
DIAG(err_pp_division_by_zero, kError, "",
     "division by zero in preprocessor expression")
DIAG(err_pp_floating_constant, kError, "",
     "floating point constant in preprocessor expression")
DIAG(err_pp_invalid_integer_constant, kError, "",
     "invalid integer constant in preprocessor expression")
DIAG(err_pp_integer_constant_too_large, kError, "",
     "integer constant is too large for preprocessor expression")
DIAG(err_pp_expected_macro_name, kError, "", "macro name missing")
DIAG(err_pp_macro_not_identifier, kError, "",
     "macro name must be an identifier")
DIAG(err_pp_missing_rparen_in_macro_def, kError, "",
     "missing ')' in macro parameter list")
DIAG(err_pp_expected_ident_in_arg_list, kError, "",
     "expected identifier in macro parameter list")
DIAG(err_pp_expected_comma_in_arg_list, kError, "",
     "expected comma in macro parameter list")
DIAG(err_pp_duplicate_name_in_arg_list, kError, "",
     "duplicate macro parameter name '%0'")
DIAG(err_pp_endif_without_if, kError, "", "#endif without #if")
DIAG(err_pp_without_if, kError, "", "#%0 without #if")
DIAG(err_pp_after_else, kError, "", "#%0 after #else")
DIAG(err_pp_unterminated_conditional, kError, "",
     "unterminated conditional directive")

// Preprocessor #include / header search diagnostics
DIAG(err_pp_expected_filename, kError, "",
     "expected \"FILENAME\" or <FILENAME>")
DIAG(err_pp_empty_filename, kError, "", "empty filename")
DIAG(err_pp_file_not_found, kError, "", "'%0' file not found")
DIAG(err_pp_include_too_deep, kError, "", "#include nested too deeply")

// Preprocessor #line / #error / #warning diagnostics
DIAG(err_pp_error_directive, kError, "", "%0")
DIAG(warn_pp_warning_directive, kWarning, "#warning", "%0")
DIAG(err_pp_line_requires_integer, kError, "",
     "#line directive requires a positive integer argument")
DIAG(err_pp_line_invalid_filename, kError, "",
     "invalid filename for #line directive")
DIAG(err_pp_invalid_directive, kError, "", "invalid preprocessing directive")

// Preprocessor #pragma diagnostics
DIAG(err_pp_poisoned_macro, kError, "", "attempt to use poisoned macro '%0'")
DIAG(warn_pp_poison_after_define, kWarning, "",
     "#pragma GCC poison was applied to a macro that was defined")
DIAG(err_pp_poison_non_identifier, kError, "", "cannot poison non-identifier")
DIAG(warn_pp_dependency_out_of_date, kWarning, "",
     "current file is older than dependency '%0'")
DIAG(err_pp_pragma_string_literal, kError, "",
     "expected a string literal for '#pragma %0'")
DIAG(err_pp_pragma_push_macro, kError, "",
     "expected \"%0\" for #pragma push_macro")
DIAG(err_pp_pragma_pop_macro, kError, "",
     "expected \"%0\" for #pragma pop_macro")
DIAG(err_pp_pragma_diagnostic_invalid, kError, "", "invalid diagnostic pragma")
DIAG(err_pp_include_next_not_found, kError, "",
     "'%0' file not found from #include_next")
DIAG(err_pp_import_failed, kError, "", "'%0' file not found for #import")

// Notes
DIAG(note_expanded_from_macro, kNote, "", "expanded from macro '%0'")
DIAG(note_in_file_included_from, kNote, "", "in file included from %0:%1")

//===----------------------------------------------------------------------===//
// Literal diagnostics (literal_support)
//===----------------------------------------------------------------------===//
DIAG(err_invalid_digit, kError, "", "invalid digit '%0' in %1 constant")
DIAG(err_invalid_suffix_constant, kError, "",
     "invalid suffix '%0' on %1 constant")
DIAG(err_exponent_has_no_digits, kError, "", "exponent has no digits")
DIAG(err_hex_constant_requires_exponent, kError, "",
     "hexadecimal floating constant requires an exponent")
DIAG(warn_integer_literal_too_large, kWarning, "implicitly-unsigned-literal",
     "integer literal is too large to be represented in a signed integer "
     "type, interpreting as unsigned")
DIAG(err_integer_literal_too_large, kError, "",
     "integer literal is too large to be represented in any integer type")
DIAG(err_empty_character, kError, "", "empty character constant")
DIAG(warn_multichar_character_constant, kWarning, "multichar",
     "multi-character character constant")
DIAG(err_escape_too_large, kError, "", "%0 escape sequence out of range")
DIAG(err_unknown_escape, kError, "", "unknown escape sequence '\\%0'")
DIAG(err_unsupported_string_concat, kError, "",
     "unsupported non-standard concatenation of string literals")

//===----------------------------------------------------------------------===//
// Parser diagnostics
//===----------------------------------------------------------------------===//
DIAG(err_expected, kError, "", "expected %0")
DIAG(err_expected_after, kError, "", "expected %1 after %0")
DIAG(err_expected_expression, kError, "", "expected expression")
DIAG(err_expected_type_name, kError, "", "expected a type")
DIAG(err_expected_ident, kError, "", "expected identifier")
DIAG(err_expected_ident_lparen, kError, "", "expected identifier or '('")
DIAG(err_expected_semi_declaration, kError, "",
     "expected ';' at end of declaration")
DIAG(err_expected_semi_after_expr, kError, "", "expected ';' after expression")
DIAG(err_expected_semi_after_stmt, kError, "",
     "expected ';' after %0 statement")
DIAG(err_expected_statement, kError, "", "expected statement")
DIAG(err_expected_lbrace_or_comma, kError, "", "expected '{' or ','")
DIAG(err_expected_fn_body, kError, "",
     "expected function body after function declarator")
DIAG(err_expected_rbrace, kError, "", "expected '}'")
DIAG(note_to_match_this_lbrace, kNote, "", "to match this '{'")
DIAG(err_expected_rsquare, kError, "", "expected ']'")
DIAG(note_to_match_this_lsquare, kNote, "", "to match this '['")
DIAG(err_invalid_decl_spec_combination, kError, "",
     "cannot combine with previous '%0' declaration specifier")
DIAG(err_duplicate_declspec, kError, "duplicate-decl-specifier",
     "duplicate '%0' declaration specifier")
DIAG(warn_missing_type_specifier, kWarning, "implicit-int",
     "type specifier missing, defaults to 'int'")
DIAG(err_declaration_does_not_declare_anything, kWarning,
     "missing-declarations", "declaration does not declare anything")
DIAG(err_typename_requires_specqual, kError, "",
     "type name requires a specifier or qualifier")
DIAG(err_invalid_storage_class_in_func_decl, kError, "",
     "invalid storage class specifier in function declarator")
DIAG(err_typename_invalid_storageclass, kError, "",
     "type name does not allow storage class to be specified")
DIAG(err_unexpected_typedef_ident, kError, "",
     "unexpected type name '%0': expected identifier")
DIAG(err_illegal_decl_no_name, kError, "",
     "declaration of anonymous %0 must be a definition")
DIAG(err_unknown_typename, kError, "", "unknown type name '%0'")
DIAG(err_use_of_tag_name_without_tag, kError, "",
     "must use '%0' tag to refer to type '%1'")
DIAG(err_expected_case_colon, kError, "", "expected ':' after '%0'")
DIAG(err_generic_expected_comma_or_rparen, kError, "",
     "expected ',' or ')' in '_Generic' selection")
DIAG(err_argument_required_after_attribute, kError, "",
     "argument required after attribute")
DIAG(err_knr_definition_unsupported, kError, "",
     "K&R-style function definitions are not supported")
DIAG(err_parameter_requires_type, kError, "",
     "parameter requires a type specifier")
DIAG(err_expected_parameter_declarator, kError, "",
     "expected parameter declarator")
DIAG(err_designator_expected_field_name, kError, "",
     "expected a field designator, such as '.field = 4'")
DIAG(err_expected_equal_designator, kError, "",
     "expected '=' or another designator")
DIAG(err_static_assert_expected_string, kError, "",
     "expected string literal for diagnostic message in static_assert")

//===----------------------------------------------------------------------===//
// Sema: declaration diagnostics
//===----------------------------------------------------------------------===//
DIAG(err_undeclared_var_use, kError, "", "use of undeclared identifier '%0'")
DIAG(err_implicit_function_decl, kError, "implicit-function-declaration",
