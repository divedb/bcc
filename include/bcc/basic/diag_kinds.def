     "implicit function declarations")
DIAG(err_redefinition, kError, "", "redefinition of '%0'")
DIAG(err_redefinition_different_kind, kError, "",
     "redefinition of '%0' as different kind of symbol")
DIAG(err_redefinition_different_type, kError, "",
     "redefinition of '%0' with a different type: '%1' vs '%2'")
DIAG(err_conflicting_types, kError, "", "conflicting types for '%0'")
DIAG(note_previous_definition, kNote, "", "previous definition is here")
DIAG(note_previous_declaration, kNote, "", "previous declaration is here")
DIAG(err_static_non_static, kError, "",
     "static declaration of '%0' follows non-static declaration")
DIAG(err_non_static_static, kError, "",
